# Copy this file to ~/.dbt/profiles.yml (do NOT commit real credentials).
# Ask your facilitator for the connection details.

mediapulse:
  target: dev
  outputs:
    dev:
      type: snowflake             # or bigquery / databricks - ask your facilitator
      account: "your-account"
      user: "your-user"
      password: "your-password"
      role: "TRANSFORMER"
      database: "MEDIAPULSE_DEV"  # your personal dev database
      warehouse: "COMPUTE_WH"
      schema: "dbt_yourname"      # personalise this - e.g. dbt_lucy
      threads: 4

    # --- BigQuery alternative (bigquery-compat branch) -------------------
    # Replace the `dev` block above with this if your facilitator put you
    # on BigQuery. This single-project variant already keeps its raw
    # `database` behind the `raw_database` var (commented out in the news
    # source), so leave that as-is and let seeds load into your dataset.
    #
    # dev:
    #   type: bigquery
    #   method: oauth            # or service-account (+ keyfile:)
    #   project: "your-gcp-project-id"
    #   dataset: "dbt_yourname"  # personalise this - e.g. dbt_lucy
    #   location: "EU"           # or US - match your facilitator's setup
    #   threads: 4

    prod:
      type: snowflake
      account: "your-account"
      user: "svc_dbt"
      password: "{{ env_var('DBT_PASSWORD') }}"
      role: "TRANSFORMER"
      database: "MEDIAPULSE"
      warehouse: "COMPUTE_WH"
      schema: "prod"
      threads: 8
